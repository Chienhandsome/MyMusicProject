# Public Firebase identifiers only. Empty values keep app access disabled.
# This is the NUMERIC project number, not the textual project ID.
FIREBASE_PROJECT_NUMBER=
# Comma-separated Firebase App IDs, not Android package names.
FIREBASE_APP_IDS=
DOWNLOAD_SERVER_PORT=8000
DOWNLOAD_SERVER_BIND_ADDRESS=127.0.0.1
# Optional compose.cookies.yaml: host source only, NOT the writable job copy.
YTDLP_COOKIES_SOURCE=./.secrets/youtube.cookies.txt
